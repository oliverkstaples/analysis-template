{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Scripts must run as modules from the repo root (see AGENTS.md): running
            // scripts/<name>.py by path fails on `from scripts.inputs import ...`.
            "name": "Python Debugger: Current Script as Module, with Arguments",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}
